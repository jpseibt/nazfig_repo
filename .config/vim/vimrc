let s:is_win = has('win32') || has('win64')

function! ShellEscape(str)
  if s:is_win
    return '"' . tr(a:str, '/', '\') . '"'
  else
    return shellescape(a:str)
  endif
endfunction

" Return a string with the last visual selection or the under-the-cursor area.
" Example command using <range> to dynamically pass an expression to a function:
"   > command! -range=0 ThisExpr call FuncExpectingExpr(GetVisualOrCursorArea(<range>))
"   > :ThisExpr        | under the cursor
"   > :'<,'>ThisExpr   | last visual selection
"   > :64ThisExpr      | also last visual selection (the default -range=0 is used like a flag)
" NOTE: see `:help gv` - the unnamed register (@") is used to store the visual selection area.
function! s:GetVisualOrCursorArea(range)
  let l:area = ''
  if a:range == 0
    let l:area = expand('<cword>')
  else
    silent normal! gv""y
    let l:area = trim(@")
  endif
  return tr(l:area, "\n", ' ')
endfunction

" Base 1024 sizes
let s:KB = 1024
let s:MB = 1048576
let s:GB = 1073741824

" Return human-readable size (base 1024), and last modified (Y-M-D H:M:S) string from file.
function! s:GetFileInfoFormatStr(file_path)
  let l:file_size = getfsize(a:file_path)
  let l:file_time = getftime(a:file_path)
  let l:result = ''

  " Size
  if l:file_size <= 0
    if l:file_size == 0
      let l:result = isdirectory(a:file_path) ? 'DIR' : '0B'
    elseif l:file_size == -1
      let l:result = 'ENOENT'
    elseif l:file_size == -2
      let l:result = 'EOVERFLOW'
    endif
  else
    if l:file_size < s:KB
      let l:result = l:file_size . 'B'
    elseif l:file_size < s:MB
      let l:result = printf("%.1fK", l:file_size / (s:KB * 1.0))
    elseif l:file_size < s:GB
      let l:result = printf("%.1fM", l:file_size / (s:MB * 1.0))
    else
      let l:result = printf("%.1fG", l:file_size / (s:GB * 1.0))
    endif
  endif
  let l:result = printf("%6s", l:result)

  " Last modified
  if l:file_time != -1
    let l:result = printf("%s %s", l:result, strftime("%Y-%m-%d %H:%M:%S", l:file_time))
  endif

  return l:result
endfunction

