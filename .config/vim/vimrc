" C++ final build
command! MakecppRelease call s:SetMakeprg('MakecppRelease', printf('%s -O3 %s "%%:p" -o "%s"', s:cpp_compiler, s:cpp_flags, s:dft_out_file), s:dft_out_file)

" C fsyntax-only
