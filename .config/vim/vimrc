"
function! s:TdbgSetup()
  nnoremap <S-F5>  :Gdb<CR>i<CR>quit<CR>y<CR>
  tnoremap <S-F5>  <C-\><C-n>:Gdb<CR>i<CR>quit<CR>y<CR>
  nnoremap <S-F9>  :Tdbgbreak<CR>
  nnoremap <S-F11> :Tdbgcmd finish<CR>
  tnoremap <S-F11> <C-\><C-n>:Tdbgcmd finish<CR>i
  nnoremap <F11>   :Tdbgcmd step<CR>
  tnoremap <F11>   <C-\><C-n>:Tdbgcmd step<CR>i
  nnoremap <F10>   :Tdbgcmd next<CR>
  tnoremap <F10>   <C-\><C-n>:Tdbgcmd next<CR>i
  nnoremap <F9>    :Break<CR>
  nnoremap <F5>    :Tdbgcmd continue<CR>
  tnoremap <F5>    <C-\><C-n>:Tdbgcmd continue<CR>i
  nnoremap <A-w>   :Tdbgwatchthis<CR>
  vnoremap <A-w>   :Tdbgwatchthis<CR>
  nnoremap <A-g>   :Tdbgmemthis<CR>
  vnoremap <A-g>   :Tdbgmemthis<CR>
  nnoremap <A-G>   :Tdbgmemaround<CR>
  vnoremap <A-G>   :Tdbgmemaround<CR>
  echohl WarningMsg | echo '- termdebug mappings enabled -' | echohl None

  " Resize source/variables/disassembly window, set local scrolloff, then jump to gdb window
  execute 'Asm'
  execute 'setlocal scrolloff=999'
  execute 'Source'
  execute 'setlocal scrolloff=999'
  execute 'resize 24'
  execute 'vert resize 108'
  execute 'Gdb'
endfunction

function! s:TdbgTearDown()
  silent! nunmap <S-F5>
  silent! tunmap <S-F5>
  silent! nunmap <S-F9>
  silent! nunmap <S-F11>
  silent! tunmap <S-F11>
  silent! nunmap <F11>
  silent! tunmap <F11>
  silent! nunmap <F10>
  silent! tunmap <F10>
  silent! nunmap <F9>
  silent! nunmap <F5>
  silent! tunmap <F5>
  silent! nunmap <A-w>
  silent! vunmap <A-w>
  silent! nunmap <A-g>
  silent! vunmap <A-g>
  silent! nunmap <A-G>
  silent! vunmap <A-G>
  echohl WarningMsg | echo '- termdebug mappings disabled -' | echohl None

  " Reset scrolloff to global value, then jump to gdb window
  silent! execute 'Asm'
  silent! execute 'setlocal scrolloff<'
  silent! execute 'Source'
  silent! execute 'setlocal scrolloff<'
  silent! execute 'Gdb'
endfunction

