" C final build
command! MakecRelease call s:SetMakeprg('MakecRelease', printf('%s -O3 %s "%%:p" -o "%s"', s:c_compiler, s:c_flags, s:dft_out_file), s:dft_out_file)

" C++ debug build (default for .cpp)
