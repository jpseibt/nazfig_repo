function! s:GerminalHere(mode, count)
  let l:head_dir = (&filetype == 'netrw') ? b:netrw_curdir : expand('%:p:h')
  call s:GlobalTerminal(a:mode, a:count)
  call feedkeys("i\<C-c> cd " . ShellEscape(l:head_dir) . "\<CR>\<Esc>", 't')
endfunction

